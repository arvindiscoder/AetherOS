{
  "manifest_version": 3,
  "name": "Aether Astra",
  "version": "1.0.0",
  "description": "AetherOS assistant bridge: omnibox keyword, context menu, and a local side panel.",
  "permissions": ["sidePanel", "contextMenus", "storage", "tabs"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Aether Astra" },
  "omnibox": { "keyword": "astra" },
  "commands": {
    "open-astra": {
      "suggested_key": { "default": "Ctrl+Shift+A" },
      "description": "Open the Aether Astra side panel"
    }
  }
}
