[Unit]
Description=AetherOS first boot setup
Documentation=file:///usr/share/aether/docs/README.md
ConditionPathExists=!/var/lib/aether/.firstboot
After=local-fs.target systemd-remount-fs.service
Before=getty@tty1.service display-manager.service
Wants=systemd-timesyncd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/aether-firstboot
StandardOutput=journal
StandardError=journal
TimeoutStartSec=90s

[Install]
WantedBy=multi-user.target
