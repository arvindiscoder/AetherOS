#!/bin/sh
# AetherOS first-boot setup. Idempotent; guarded by the unit's Condition.
set -eu

MARK=/var/lib/aether/.firstboot
[ -e "$MARK" ] && exit 0

mkdir -p /var/lib/aether /var/cache/aether /opt/aether/packs
chmod 0755 /var/lib/aether /var/cache/aether /opt/aether /opt/aether/packs

# live-boot normally provides a machine-id; an installed frugal system may not.
if [ ! -s /etc/machine-id ]; then
  systemd-machine-id-setup >/dev/null 2>&1 || true
fi

# Rebuild caches that cannot be built correctly inside the image chroot.
fc-cache -f >/dev/null 2>&1 || true
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f -t /usr/share/icons/Adwaita >/dev/null 2>&1 || true
fi
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
update-mime-database /usr/share/mime >/dev/null 2>&1 || true

# Create XDG folders for the desktop user without starting a session.
if command -v runuser >/dev/null 2>&1; then
  runuser -u aether -- env HOME=/home/aether XDG_CONFIG_HOME=/home/aether/.config \
    xdg-user-dirs-update >/dev/null 2>&1 || true
fi

# The live ISO has no persistent clock; sync once if the network is up.
systemctl start systemd-timesyncd.service >/dev/null 2>&1 || true

date -u +%Y-%m-%dT%H:%M:%SZ >"$MARK"
exit 0
